########################################################################
# Voice Inbox — local n8n deployment environment
#
# Copy this file to `deploy/.env` and fill in real values there.
# `deploy/.env` is gitignored and must NEVER be committed.
# Every value in THIS file (.env.example) must stay a placeholder or
# be left empty — no real secrets, no real filesystem paths that reveal
# anything about this machine.
########################################################################

# --- Secrets ---

# Required. Encrypts n8n's credential store (API keys, etc. entered
# inside n8n's UI). Generate a fresh random value locally, e.g.:
#   openssl rand -hex 32
# Do not reuse this value across deployments and do not commit it.
N8N_ENCRYPTION_KEY=

# --- Network ---

# Host-side port n8n's UI/API is published on, bound to 127.0.0.1 only
# (see docker-compose.yml — the bind is hardcoded to localhost; this
# only controls which local port to use if 5678 is already taken).
N8N_HOST_PORT=5678

# --- Timezone ---

GENERIC_TIMEZONE=UTC

# --- Data paths (host side) ---
# Paths are resolved relative to this file's directory (deploy/) unless
# absolute. Defaults assume the standard repo layout, i.e. these
# directories exist as siblings of deploy/ at the repo root:
#   recordings/   Superwhisper output — mounted READ-ONLY.
#   output/       Processed idea records — mounted READ-WRITE.
#   logs/         Structured, transcript-free diagnostic logs — READ-WRITE.
#   dead-letter/  Exhausted-retry / terminal-failure records — READ-WRITE.
# All four are covered by the repo's .gitignore gate list (see #1) and
# must never be tracked in Git. Override any of these with an absolute
# path if your Superwhisper recordings folder lives elsewhere on disk.

RECORDINGS_HOST_PATH=../recordings
OUTPUT_HOST_PATH=../output
LOGS_HOST_PATH=../logs
DEAD_LETTER_HOST_PATH=../dead-letter

# --- Execution data retention ---
# How long (hours) n8n keeps execution history (mainly failures, since
# EXECUTIONS_DATA_SAVE_ON_SUCCESS is fixed to "none" in
# docker-compose.yml) before pruning. Kept short deliberately — this is
# a diagnostic window, not a long-term audit log.
EXECUTIONS_DATA_MAX_AGE_HOURS=72

# Hard cap on the number of retained executions regardless of age.
EXECUTIONS_DATA_PRUNE_MAX_COUNT=1000
